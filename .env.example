# Copy to .env and fill in as needed. All values are optional for the demo:
# with no LLM_API_KEY the app runs in deterministic offline fallback mode.

# --- LLM (optional) ---
# LLM_PROVIDER=gemini            # gemini | openai
# LLM_API_KEY=your-key-here      # leave blank to run offline (deterministic fallback)
# LLM_MODEL=gemini-1.5-flash

# --- Classifier ---
# CLASSIFIER_CONFIDENCE_THRESHOLD=0.6

# --- Follow-up ---
# FOLLOWUP_WAIT_WINDOW_HOURS=168
# FOLLOWUP_SCAN_CRON=0 0 * * * *

# --- Database (defaults match docker-compose) ---
# DB_URL=jdbc:postgresql://db:5432/privacypilot
# DB_USERNAME=privacypilot
# DB_PASSWORD=privacypilot
